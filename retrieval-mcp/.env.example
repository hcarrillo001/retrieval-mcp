# ---- RetriEval MCP server (Railway) ----
# Judge backend: "anthropic" (needs key) or "ollama" (local/free)
RETRIEVAL_JUDGE_BACKEND=anthropic
RETRIEVAL_JUDGE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...
# For free local judging instead:
# RETRIEVAL_JUDGE_BACKEND=ollama
# RETRIEVAL_JUDGE_MODEL=deepseek-r1:70b
# OLLAMA_URL=http://localhost:11434/api/chat

# Auth for the HTTP endpoint (required in production)
RETRIEVAL_TOKEN=change-me-openssl-rand-hex-24

# Optional in-app spend cap (0/unset = unlimited; the API key is the real ceiling)
RETRIEVAL_BUDGET_USD=0

# Shared run history (set these on BOTH Railway and Vercel)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY
RETRIEVAL_RUNS_TABLE=runs

# ---- Dashboard (Vercel) only ----
# Optional: gate /api/runs behind a secret, then load /?key=...
# DASH_TOKEN=some-secret

# Or judge with OpenAI / any OpenAI-compatible provider:
# RETRIEVAL_JUDGE_BACKEND=openai
# OPENAI_API_KEY=sk-...
# RETRIEVAL_JUDGE_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1   # or OpenRouter, vLLM, etc.
